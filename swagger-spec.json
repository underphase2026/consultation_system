        "responses": {
          "200": {
            "description": "발송 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "너무 많은 요청 (분당 3회 초과)"
          }
        },
        "summary": "SMS 인증번호 발송 요청 (분당 3회 제한)",
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/auth/sms/verify": {
      "post": {
        "description": "인증번호 일치 시 5분 유효한 phoneVerifyToken을 반환합니다. 회원가입 시 이 토큰을 사용하세요.",
        "operationId": "AuthController_verifySmsCode",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifySmsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "인증 성공 — phoneVerifyToken 반환",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "success": true,
                    "data": {
                      "phoneVerifyToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                      "expiresIn": 300
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "인증번호 불일치 또는 만료"
          },
          "429": {
            "description": "너무 많은 요청 (분당 5회 초과)"
          }
        },
        "summary": "SMS 인증번호 검증 (분당 5회 제한)",
        "tags": [
          "Auth"
        ]
      }
    },
