    "/api/api/consultations/devices": {
      "get": {
        "description": "조건에 맞는 단말기 목록과 계산된 가격(출고가, 공시지원금, 할부원금)을 반환합니다.",
        "operationId": "ConsultationsController_getDevices",
        "parameters": [
          {
            "name": "networkType",
            "required": true,
            "in": "query",
            "description": "유무선 구분",
            "schema": {
              "type": "string",
              "enum": [
                "WIRELESS",
                "WIRED"
              ]
            }
          },
          {
            "name": "carrier",
            "required": true,
            "in": "query",
            "description": "통신사",
            "schema": {
              "type": "string",
              "enum": [
                "SKT",
                "KT",
                "LGU"
              ]
            }
          },
          {
            "name": "searchType",
            "required": false,
            "in": "query",
            "description": "검색 조건 (기종명 또는 모델명)",
            "schema": {
              "type": "string",
              "enum": [
                "DEVICE_NAME",
                "MODEL_NAME"
              ]
            }
          },
          {
            "name": "keyword",
            "required": false,
            "in": "query",
            "description": "검색어",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "성공적으로 단말기 목록을 반환했습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "단말기 리스트 및 검색 API",
        "tags": [
          "Consultations (통합 유무선 상담 및 견적)"
        ]
      }
    },
