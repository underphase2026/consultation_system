    "/api/auth/sms/send": {
      "post": {
        "description": "입력한 번호로 6자리 인증번호를 발송합니다. 인증번호는 3분간 유효합니다.",
        "operationId": "AuthController_sendSmsCode",
        "parameters": [],
        "requestBody": {
          "required": true,
