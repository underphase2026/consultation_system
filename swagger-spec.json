  "info": {
    "title": "전자계약 & CRM 플랫폼 API",
    "description": "전자계약 및 CRM 기능이 포함된 플랫폼 REST API 명세서",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "reset-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid-string"
          },
          "phoneNumber": {
            "type": "string",
            "example": "01012345678"
          },
          "name": {
            "type": "string",
            "example": "홍길동"
          },
          "email": {
            "type": "string",
            "example": "test@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ],
            "example": "OWNER"
          },
          "referralCode": {
            "type": "string",
            "example": "ABCDEF"
          }
        },
        "required": [
          "id",
          "phoneNumber",
          "name",
          "role",
          "referralCode"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "홍길순",
            "description": "이름"
          },
          "phoneNumber": {
            "type": "string",
            "example": "01099998888",
            "description": "휴대폰 번호"
          },
          "password": {
            "type": "string",
            "description": "새 비밀번호 (최소 8자)"
          },
          "marketingAgreed": {
            "type": "boolean",
            "description": "마케팅 수신 동의"
          }
        }
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Password has been reset successfully."
          }
        },
        "required": [
          "message"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "example": "01012345678",
            "description": "휴대폰 번호"
          },
          "password": {
            "type": "string",
            "example": "Password1234!",
            "description": "비밀번호"
          }
        },
        "required": [
          "phoneNumber",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "TermsDto": {
        "type": "object",
        "properties": {
          "serviceAgreed": {
            "type": "boolean",
            "description": "이용 약관 동의 (필수, true여야 함)"
          },
          "privacyAgreed": {
            "type": "boolean",
            "description": "개인정보 수집 동의 (필수, true여야 함)"
          },
          "marketingAgreed": {
            "type": "boolean",
            "description": "마케팅 수신 동의 (선택)",
            "default": false
          }
        },
        "required": [
          "serviceAgreed",
          "privacyAgreed"
        ]
      },
      "RegisterOwnerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "홍길동",
            "description": "이름"
          },
          "phoneNumber": {
            "type": "string",
            "example": "01012345678",
            "description": "휴대폰 번호"
          },
          "email": {
            "type": "string",
            "example": "owner@example.com",
            "description": "이메일 (선택)"
          },
          "password": {
            "type": "string",
            "example": "Password1234!",
            "description": "비밀번호 (최소 8자)"
          },
          "terms": {
            "description": "약관 동의",
            "allOf": [
              {
                "$ref": "#/components/schemas/TermsDto"
              }
            ]
          }
        },
        "required": [
          "name",
          "phoneNumber",
          "password",
          "terms"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Owner registered successfully."
          },
          "userId": {
            "type": "string",
            "example": "uuid-string"
          }
        },
        "required": [
          "message",
          "userId"
        ]
      },
      "RegisterStaffDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "김직원",
            "description": "이름"
          },
          "phoneNumber": {
            "type": "string",
            "example": "01098765432",
            "description": "휴대폰 번호"
          },
          "email": {
            "type": "string",
            "example": "staff@example.com",
            "description": "이메일 (선택)"
          },
          "password": {
            "type": "string",
            "example": "Password1234!",
            "description": "비밀번호 (최소 8자)"
          },
          "terms": {
            "description": "약관 동의",
            "allOf": [
              {
                "$ref": "#/components/schemas/TermsDto"
              }
            ]
          }
        },
        "required": [
          "name",
          "phoneNumber",
          "password",
          "terms"
        ]
      },
      "ResetTokenResponseDto": {
        "type": "object",
        "properties": {
          "resetToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "resetToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "example": "NewPassword5678!",
            "description": "변경할 새 비밀번호 (최소 8자)"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "StoreItemResponseDto": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "example": "uuid-string"
          },
          "storeName": {
            "type": "string",
            "example": "홍길동 강남점"
          },
          "address": {
            "type": "string",
            "example": "서울 강남구 테헤란로 123, 2층"
          },
          "rate": {
            "type": "string",
            "example": "프리미엄 요금제"
          },
          "ownerName": {
            "type": "string",
            "example": "홍길동"
          },
          "phoneNumber": {
            "type": "string",
            "example": "0212345678"
          }
        },
        "required": [
          "storeId",
          "storeName",
          "address",
          "ownerName",
          "phoneNumber"
        ]
      },
      "CreateStoreDto": {
        "type": "object",
        "properties": {
          "storeBusinessName": {
            "type": "string",
            "example": "홍길동통신",
            "description": "사업자등록증 상 상호명"
          },
          "storeName": {
            "type": "string",
            "example": "홍길동 강남점",
            "description": "매장 표시명"
          },
          "businessRegistrationNumber": {
            "type": "string",
            "example": "1234567890",
            "description": "사업자 등록번호 (10자리, 하이픈 없이)"
          },
          "postcode": {
            "type": "string",
            "example": "06234",
            "description": "우편번호"
          },
          "roadAddress": {
            "type": "string",
            "example": "서울 강남구 테헤란로 123",
            "description": "도로명 주소"
          },
          "jibunAddress": {
            "type": "string",
            "example": "서울 강남구 역삼동 123",
            "description": "지번 주소"
          },
          "detailedAddress": {
            "type": "string",
            "example": "2층 201호",
            "description": "상세 주소"
          },
          "lat": {
            "type": "number",
            "example": 37.5005,
            "description": "위도 (Latitude)"
          },
          "lng": {
            "type": "number",
            "example": 127.0364,
            "description": "경도 (Longitude)"
          },
          "storePhonenumber": {
            "type": "string",
            "example": "0212345678",
            "description": "매장 전화번호 (선택)"
          }
        },
        "required": [
          "storeBusinessName",
          "storeName",
          "businessRegistrationNumber",
          "postcode",
          "detailedAddress",
          "lat",
          "lng"
        ]
      },
      "CreateStoreResponseDto": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "example": "uuid-string"
          },
          "storeName": {
            "type": "string",
            "example": "홍길동 강남점"
          },
          "storeCode": {
            "type": "string",
            "example": "ABCD1234"
          }
        },
        "required": [
          "storeId",
          "storeName",
          "storeCode"
        ]
      },
      "JoinStoreDto": {
        "type": "object",
        "properties": {
          "storeCode": {
            "type": "string",
            "example": "ABCD1234",
            "description": "매장 합류 코드"
          }
        },
        "required": [
