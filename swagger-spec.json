  "info": {
    "title": "전자계약 & CRM 플랫폼 API",
    "description": "전자계약 및 CRM 기능이 포함된 플랫폼 REST API 명세서",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "reset-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid-string"
          },
          "phoneNumber": {
            "type": "string",
            "example": "01012345678"
          },
          "name": {
            "type": "string",
            "example": "홍길동"
          },
          "email": {
            "type": "string",
            "example": "test@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "STAFF"
            ],
            "example": "OWNER"
          },
          "referralCode": {
            "type": "string",
            "example": "ABCDEF"
          }
        },
        "required": [
          "id",
          "phoneNumber",
          "name",
          "role",
          "referralCode"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "홍길순",
            "description": "이름"
          },
          "phoneNumber": {
            "type": "string",
            "example": "01099998888",
            "description": "휴대폰 번호"
          },
          "password": {
            "type": "string",
            "description": "새 비밀번호 (최소 8자)"
          },
          "marketingAgreed": {
            "type": "boolean",
            "description": "마케팅 수신 동의"
          },
          "email": {
            "type": "string",
            "description": "이메일"
          },
          "birthDate": {
            "type": "string",
            "description": "생년월일 (YYYY-MM-DD)"
          }
        }
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Password has been reset successfully."
          }
        },
        "required": [
          "message"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string",
            "example": "01012345678",
            "description": "휴대폰 번호"
          },
